{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MirrorShard 2",
  "version": "1.14.1",
  "identifier": "com.DroicheadNua.mirrorshard2",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "mirrorshard-ver02",
        "label": "main",
        "visible": false,
        "width": 800,
        "height": 600,
        "minWidth": 640,
        "minHeight": 480,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "transparent": true,
        "closable": true,
        "maximizable": true,
        "minimizable": true,
        "devtools": false,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": {
          "default-src": "'self' customprotocol: asset:",
          "script-src": "'self'",
          "style-src": "'self' 'unsafe-inline'",
          "connect-src": "'self' ipc: asset: http://ipc.localhost http://asset.localhost https://generativelanguage.googleapis.com https://api.cohere.com https://api.groq.com https://api.cerebras.ai https://openrouter.ai https://api.mistral.ai https://apihub.agnes-ai.com http://127.0.0.1:* http://localhost:*",
          "img-src": "'self' customprotocol: asset: http://asset.localhost blob: data: http: https:",
          "font-src": "'self' customprotocol: asset: http://asset.localhost data:",
          "media-src": "'self' customprotocol: asset: http://asset.localhost blob: data:",
          "object-src": "'none'",
          "base-uri": "'self'"
      },
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    },
    "macOSPrivateApi": true
  },
  "plugins": {
    "cli": {
      "description": "MirrorShard CLI",
      "args": [
        {
          "name": "filePath",
          "index": 1,
          "description": "Path to the file to open.",
          "takesValue": true,
          "required": false
        }
      ]
    }
  },
  "bundle": {
    "fileAssociations": [
      {
        "ext": ["md", "txt"],
        "name": "Text Document",
        "role": "Editor"
      },
      {
        "ext": ["html", "css", "js", "ts", "rs", "py"],
        "name": "Source Code",
        "role": "Editor"
      }
    ],
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "../docs/*",
      "../README.md",
      "../README-ja.md",
      "../Changelog-ja.md",
      "../Changelog.md",
      "resources/**/*"
    ],
    "windows": {
      "wix": {
        "language": "ja-JP"
      }
    },
    "macOS": {
      "dmg": {
        "windowSize": {
          "width": 800,
          "height": 600
        }
      }
    },
    "linux": {
      "deb": {
        "files": {}
      }
    }
  }
}
