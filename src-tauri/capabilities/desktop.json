{
  "identifier": "desktop-capability",
  "platforms": [
    "macOS",
    "windows",
    "linux"
  ],
  "windows": [
    "*"
  ],
  "permissions": [
    "window-state:default",
    "cli:default",
    {
      "identifier": "shell:allow-open",
      "allow": [
        {
          "schemes": [
            "http",
            "https",
            "mailto",
            "tel"
          ]
        }
      ]
    },
    "http:default",
    {
      "identifier": "http:allow-fetch",
      "allow": [
        {
          "url": "https://*.blob.core.windows.net/*"
        },
        {
          "url": "https://api.mistral.ai/*"
        }
      ]
    },
    "dialog:default"
  ]
}