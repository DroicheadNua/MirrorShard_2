{
  "identifier": "desktop-capability",
  "platforms": [
    "macOS",
    "windows",
    "linux"
  ],
  "windows": [
    "main"
  ],
  "permissions": [
    "window-state:default",
    "cli:default",
    {
      "identifier": "shell:allow-open",
      "allow": [
        {
          "schemes": [
            "http",
            "https",
            "mailto",
            "tel"
          ]
        }
      ]
    }
  ]
}